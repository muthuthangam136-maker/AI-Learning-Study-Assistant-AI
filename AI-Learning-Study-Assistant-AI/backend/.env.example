# AI Learning & Study Assistant - Environment Configuration

# Set to 'true' to run in full offline Demo Mode (no API key needed)
# Set to 'false' to connect to a real LLM API
DEMO_MODE=true

# OpenAI or OpenAI-Compatible API Configuration
# Examples:
# For OpenAI: https://api.openai.com/v1 (leave blank for standard OpenAI)
# For Ollama: http://localhost:11434/v1
# For Groq: https://api.groq.com/openai/v1
# For OpenRouter: https://openrouter.ai/api/v1
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Backend Application Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# Storage & Vector Database Paths
DATABASE_URL=sqlite:///./data/app.db
CHROMA_PATH=./data/chroma
KNOWLEDGE_BASE_DIR=./data/knowledge_base

# Embedding Model Configuration
# Uses lightweight local sentence-transformers model (downloads automatically)
EMBEDDING_MODEL=all-MiniLM-L6-v2
